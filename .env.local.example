# Copy this file to .env.local and fill in your values.
# See SETUP.md for step-by-step instructions.

# ─── Database (Neon Serverless PostgreSQL) ───────────────────────
# console.neon.tech → your project → Connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ─── NextAuth ────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=your-random-32-char-secret
NEXTAUTH_URL=https://your-site.vercel.app

# ─── Resend (magic link emails) ──────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender domain in your Resend account
AUTH_RESEND_FROM=noreply@yourdomain.com

# ─── Lemon Squeezy ───────────────────────────────────────────────
# app.lemonsqueezy.com → Settings → API
LEMON_SQUEEZY_API_KEY=eyJ0...
# app.lemonsqueezy.com → your store → Settings
LEMON_SQUEEZY_STORE_ID=12345
# app.lemonsqueezy.com → Webhooks → secret
LEMON_SQUEEZY_WEBHOOK_SECRET=wh_xxxxxxxxxxxxxxxxxxxx
# your subscription product → Variants → variant ID
LEMON_SQUEEZY_SUBSCRIPTION_VARIANT_ID=67890
# your bundle product → Variants → variant ID (fill in later)
LEMON_SQUEEZY_BUNDLE_VARIANT_ID=

# ─── Sanity (optional) ───────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
